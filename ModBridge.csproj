<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DiceModders.ModBridge</AssemblyName>
    <Product>ModBridge</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>DiceModders.ModBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="interop/*.dll">
      <Private>false</Private>
    </Reference>
    <!-- the two libraries this plugin connects: build them first (or point these at the DLLs of a release) -->
    <Reference Include="DiceModders.UiKit">
      <HintPath>..\UiKit\bin\Release\net6.0\DiceModders.UiKit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DiceModders.ModCore">
      <HintPath>..\ModCore\bin\Release\net6.0\DiceModders.ModCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
